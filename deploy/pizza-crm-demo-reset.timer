# Каждую ночь в 05:00 по Москве демо-база пересоздаётся заново — через час
# после резервной копии боевой базы (04:00), чтобы они не совпадали.
# Persistent: если в 05:00 сервер был выключен, пересоздание будет сразу после включения.
#
# Установка:  cp deploy/pizza-crm-demo-reset.* /etc/systemd/system/
#             systemctl daemon-reload && systemctl enable --now pizza-crm-demo-reset.timer
# Когда следующий запуск:  systemctl list-timers pizza-crm-demo-reset.timer

[Unit]
Description=Pizza Nazran CRM demo: recreate demo.db nightly at 05:00 Moscow time

[Timer]
OnCalendar=*-*-* 05:00:00 Europe/Moscow
Persistent=true

[Install]
WantedBy=timers.target
