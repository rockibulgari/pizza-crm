# Скопируйте этот файл в .env и впишите значения. Файл .env в git не попадает.

# Длинная случайная строка для подписи сессий. Получить:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Полный путь к базе заказов бота.
# Локально — копия: C:\Projects\pizza-crm\dev\orders.db
# На сервере — orders.db рядом с bot.py
ORDERS_DB=

# Полный путь к .env бота, оттуда панель возьмёт BOT_TOKEN (сам токен сюда не копируйте).
# Локально — C:\Projects\pizza-bot\.env
# На сервере — .env рядом с bot.py
BOT_ENV_FILE=
